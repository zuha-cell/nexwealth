---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="DipEngine — Price Drawdown Tracker" description="A personal tracking tool: how far below its 52-week high each stock currently sits.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">My Tools</p>
    <h1 class="font-display text-4xl text-indigo mb-3">DipEngine</h1>
    <p class="text-ink/70 leading-relaxed mb-6">
      This is the tracking framework I personally use for my own long-term
      stock watchlist — it simply shows how far each stock currently sits
      below its 52-week high. That's it. No buy signals, no targets, no
      timing calls — just the number, for you to research further yourself.
    </p>
    <div class="border-l-2 border-gold pl-4 mb-10 text-sm text-ink/60">
      <strong>Educational/informational only.</strong> This is not investment
      advice or a recommendation to buy, sell, or hold any security. A large
      drawdown doesn't mean a stock is "due" for a bounce, and a small one
      doesn't mean it's overpriced — do your own research or speak with a
      licensed advisor before acting on anything here.
    </div>

    <p id="data-status" class="text-xs text-ink/45 mb-4">Loading watchlist...</p>
    <div id="stock-table" class="border border-line rounded-2xl overflow-x-auto"></div>
  </section>

  <script>
    import { db } from "../../lib/firebase";
    import { doc, getDoc } from "firebase/firestore";

    interface Stock { symbol: string; name: string; high52w: number; currentPrice: number }

    function fmtINR(n: number) {
      return "₹" + Math.round(n).toLocaleString("en-IN");
    }

    async function init() {
      const statusEl = document.getElementById("data-status")!;
      const table = document.getElementById("stock-table")!;
      try {
        const snap = await getDoc(doc(db, "settings", "dipEngineWatchlist"));
        const stocks: Stock[] = snap.exists() ? snap.data().stocks ?? [] : [];

        if (!stocks.length) {
          statusEl.textContent = "Watchlist not set up yet — check back soon.";
          return;
        }
        statusEl.textContent = `Tracking ${stocks.length} stocks.`;

        const rows = stocks
          .filter((s) => s.symbol)
          .map((s) => {
            const drawdown = s.high52w > 0 ? ((s.currentPrice - s.high52w) / s.high52w) * 100 : 0;
            const colorClass = drawdown < -20 ? "text-loss" : drawdown < -8 ? "text-gold" : "text-gain";
            return `<tr class="border-t border-line">
              <td class="px-4 py-2 font-medium text-indigo">${s.symbol}</td>
              <td class="px-4 py-2 text-ink/60 text-sm">${s.name}</td>
              <td class="px-4 py-2 text-right font-mono text-sm">${fmtINR(s.high52w)}</td>
              <td class="px-4 py-2 text-right font-mono text-sm">${fmtINR(s.currentPrice)}</td>
              <td class="px-4 py-2 text-right font-mono text-sm ${colorClass}">${drawdown.toFixed(1)}%</td>
            </tr>`;
          })
          .join("");

        table.innerHTML = `
          <table class="w-full text-sm">
            <thead class="bg-indigo/5 text-left">
              <tr>
                <th class="px-4 py-3">Symbol</th>
                <th class="px-4 py-3">Name</th>
                <th class="px-4 py-3 text-right">52-Wk High</th>
                <th class="px-4 py-3 text-right">Current Price</th>
                <th class="px-4 py-3 text-right">From High</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>`;
      } catch {
        statusEl.textContent = "Couldn't load the watchlist right now.";
      }
    }

    init();
  </script>
</Layout>
