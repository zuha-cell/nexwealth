---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Get in touch to start investing, open an account, or ask a question.">
  <section class="max-w-2xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Contact</p>
    <h1 class="font-display text-4xl text-indigo mb-3">Let's talk about your money.</h1>
    <p class="text-ink/65 mb-10">
      Fill this in and I'll get back to you — or email
      <a href="mailto:md_zuhair.owner@bp.sharekhan.com" class="text-indigo underline">md_zuhair.owner@bp.sharekhan.com</a> directly.
    </p>

    <form id="lead-form" class="grid gap-5 border border-line rounded-2xl p-8">
      <label class="grid gap-2">
        <span class="text-sm font-medium">Name</span>
        <input required name="name" type="text" class="border border-line rounded-lg px-4 py-2 focus:border-indigo outline-none" />
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-medium">Phone or email</span>
        <input required name="contact" type="text" class="border border-line rounded-lg px-4 py-2 focus:border-indigo outline-none" />
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-medium">What are you looking to do?</span>
        <select name="interest" class="border border-line rounded-lg px-4 py-2 focus:border-indigo outline-none bg-white">
          <option value="open_demat">Open a demat / trading account</option>
          <option value="start_sip">Start a SIP / mutual fund investment</option>
          <option value="insurance">Compare or buy insurance</option>
          <option value="general">General question</option>
        </select>
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-medium">Message (optional)</span>
        <textarea name="message" rows="4" class="border border-line rounded-lg px-4 py-2 focus:border-indigo outline-none"></textarea>
      </label>

      <button type="submit" class="bg-indigo text-paper px-6 py-3 rounded-full font-medium hover:bg-indigoLight transition-colors">
        Send
      </button>

      <p id="form-status" class="text-sm" role="status"></p>
    </form>
  </section>

  <script>
    import { db } from "../lib/firebase";
    import { collection, addDoc, serverTimestamp } from "firebase/firestore";

    const form = document.getElementById("lead-form") as HTMLFormElement;
    const status = document.getElementById("form-status")!;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      submitBtn.disabled = true;
      status.textContent = "Sending...";

      try {
        await addDoc(collection(db, "leads"), {
          name: data.get("name"),
          contact: data.get("contact"),
          interest: data.get("interest"),
          message: data.get("message") || "",
          createdAt: serverTimestamp(),
          source: "website_contact_form",
        });
        status.textContent = "Thanks — I'll be in touch soon.";
        status.className = "text-sm text-gain";
        form.reset();
      } catch (err) {
        status.textContent = "Something went wrong — please try emailing directly instead.";
        status.className = "text-sm text-loss";
        console.error(err);
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
