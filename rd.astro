---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="RD Calculator" description="Calculate your Recurring Deposit maturity value.">
  <section class="max-w-2xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Calculator</p>
    <h1 class="font-display text-4xl text-indigo mb-3">Recurring Deposit (RD) Calculator</h1>
    <p class="text-ink/65 mb-8">Fixed monthly deposits, bank-set interest rate, compounded quarterly like most Indian RDs.</p>

    <div class="grid gap-6 bg-white/60 border border-line rounded-2xl p-8 mb-8">
      <label class="grid gap-2">
        <span class="text-sm font-medium">Monthly deposit (₹)</span>
        <input type="number" id="monthly" value="5000" min="0" step="100" class="border border-line rounded-lg px-4 py-2 font-mono" />
      </label>
      <label class="grid gap-2">
        <span class="text-sm font-medium">Annual interest rate (%)</span>
        <input type="number" id="rate" value="6.5" step="0.1" class="border border-line rounded-lg px-4 py-2 font-mono" />
      </label>
      <label class="grid gap-2">
        <span class="text-sm font-medium">Tenure (months)</span>
        <input type="number" id="tenure" value="24" min="6" max="120" class="border border-line rounded-lg px-4 py-2 font-mono" />
      </label>
    </div>

    <div class="grid sm:grid-cols-3 gap-4">
      <div class="border border-line rounded-2xl p-6">
        <p class="text-xs uppercase tracking-wide text-ink/50 mb-1">Total deposited</p>
        <p id="invested-result" class="font-mono text-xl text-indigo">₹0</p>
      </div>
      <div class="border border-line rounded-2xl p-6">
        <p class="text-xs uppercase tracking-wide text-ink/50 mb-1">Interest earned</p>
        <p id="interest-result" class="font-mono text-xl text-gain">₹0</p>
      </div>
      <div class="border border-line rounded-2xl p-6 bg-indigo">
        <p class="text-xs uppercase tracking-wide text-paper/60 mb-1">Maturity value</p>
        <p id="maturity-result" class="font-mono text-xl text-paper">₹0</p>
      </div>
    </div>
  </section>

  <script>
    function fmtINR(n: number) {
      return "₹" + Math.round(n).toLocaleString("en-IN");
    }
    function calculate() {
      const monthly = Number((document.getElementById("monthly") as HTMLInputElement).value) || 0;
      const rate = Number((document.getElementById("rate") as HTMLInputElement).value) || 0;
      const tenure = Number((document.getElementById("tenure") as HTMLInputElement).value) || 0;
      // Standard RD maturity formula, quarterly compounding.
      const n = 4; // compounding frequency per year
      const r = rate / 100;
      let maturity = 0;
      for (let m = 1; m <= tenure; m++) {
        const monthsRemaining = tenure - m + 1;
        maturity += monthly * Math.pow(1 + r / n, (n * monthsRemaining) / 12);
      }
      const invested = monthly * tenure;
      document.getElementById("invested-result")!.textContent = fmtINR(invested);
      document.getElementById("interest-result")!.textContent = fmtINR(maturity - invested);
      document.getElementById("maturity-result")!.textContent = fmtINR(maturity);
    }
    document.querySelectorAll("input").forEach((el) => el.addEventListener("input", calculate));
    calculate();
  </script>
</Layout>
