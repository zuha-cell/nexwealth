rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read-only reference data — populated by you via the Admin Panel,
    // never written to directly by site visitors.
    match /{collection}/{docId}
        where collection in [
          'videos', 'articles', 'calculators', 'marketData', 'mutualFunds',
          'etfs', 'fdRates', 'savingsRates', 'inflation', 'goldPrices',
          'repoRates', 'referrals', 'settings'
        ] {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Leads: anyone can create (contact form / referral clicks),
    // nobody can read or edit from the client — only the admin console / backend.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
