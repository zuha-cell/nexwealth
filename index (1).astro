---
import Layout from "../../layouts/Layout.astro";

const calculators = [
  { name: "Compare Everything (SIP/Lumpsum, Savings, FD, Funds)", href: "/calculators/compare" },
  { name: "Savings & Investment (Budget Rules)", href: "/calculators/savings-investment" },
  { name: "Browse Mutual Funds", href: "/calculators/funds" },
  { name: "Retirement Calculator", href: "/calculators/retirement" },
  { name: "FIRE Calculator", href: "/calculators/fire" },
  { name: "Insurance Needs Calculator", href: "/calculators/insurance-needs" },
  { name: "EMI Calculator", href: "/calculators/emi" },
  { name: "PPF Calculator", href: "/calculators/ppf" },
  { name: "RD Calculator", href: "/calculators/rd" },
  { name: "SWP Calculator", href: "/calculators/swp" },
  { name: "STP Calculator", href: "/calculators/stp" },
  { name: "NPS Calculator", href: "/calculators/nps" },
  { name: "Emergency Fund Calculator", href: "/calculators/emergency-fund" },
  { name: "Goal Planning Calculator", href: "/calculators/goal-planning" },
  { name: "Tax Calculator", href: "/calculators/tax" },
  { name: "Savings vs Inflation", href: "/calculators/savings-vs-inflation" },
  { name: "Asset Allocation", href: "/calculators/asset-allocation" },
  { name: "Mutual Fund Comparison", href: "/calculators/mutual-fund-comparison" },
  { name: "ETF Comparison", href: "/calculators/etf-comparison" },
  { name: "Savings Account Comparison", href: "/calculators/savings-account-comparison" },
  { name: "FD Comparison", href: "/calculators/fd-comparison" },
  { name: "Gold Comparison", href: "/calculators/gold-comparison" },
];
---

<Layout title="Calculators">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="font-display text-4xl text-indigo mb-3">Calculators</h1>
    <p class="text-ink/65 mb-10">Every calculator here is live. The comparison-type ones (Mutual Fund/ETF/Savings/FD/Gold Comparison, Savings vs Inflation, Asset Allocation) route into the all-in-one Compare tool, since that already covers the same ground with real data.</p>
    <div class="grid sm:grid-cols-3 gap-4">
      {calculators.map((c) => (
        <a href={c.href} class="border border-line rounded-xl p-5 hover:border-indigo transition-colors">
          <p class="font-medium text-indigo">{c.name}</p>
          <p class="text-xs text-gain mt-1">Live</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
