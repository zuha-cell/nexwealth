---
import "../styles/global.css";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import AIHelper from "../components/AIHelper.astro";
import LanguageToggle from "../components/LanguageToggle.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Plan today. Prosper tomorrow. Unbiased financial education and practical calculators.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/icon-512.png", Astro.site);
const pageTitle = `${title} · NEXWEALTH`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NEXWEALTH" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#1B2A4A" />
  </head>
  <body>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Offline support is a nice-to-have, not critical — fail silently.
          });
        });
      }
    </script>
    <header class="border-b border-line">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="font-display text-xl tracking-tight text-indigo">
          NEX<span class="text-gold">WEALTH</span>
        </a>
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-ink/80">
          <a href="/learn" class="hover:text-indigo" data-i18n="nav_learn">Learning Centre</a>
          <a href="/videos" class="hover:text-indigo" data-i18n="nav_videos">Videos</a>
          <a href="/calculators" class="hover:text-indigo" data-i18n="nav_calculators">Calculators</a>
          <a href="/resources" class="hover:text-indigo" data-i18n="nav_resources">Resources</a>
          <a href="/blog" class="hover:text-indigo" data-i18n="nav_blog">Blog</a>
        </nav>
        <div class="flex items-center gap-3">
          <LanguageToggle />
          <a
            href="/contact"
            class="text-sm font-medium bg-indigo text-paper px-4 py-2 rounded-full hover:bg-indigoLight transition-colors"
            data-i18n="nav_contact"
          >
            Contact
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line mt-24">
      <div class="max-w-6xl mx-auto px-6 py-10 text-sm text-ink/60 flex flex-col md:flex-row justify-between gap-4">
        <p>© {new Date().getFullYear()} NEXWEALTH. <span data-i18n="footer_tagline">Educational content only — not investment advice.</span></p>
        <div class="flex gap-6">
          <a href="/about" class="hover:text-indigo" data-i18n="footer_about">About</a>
          <a href="/resources" class="hover:text-indigo" data-i18n="footer_resources">Resources</a>
          <a href="/contact" class="hover:text-indigo" data-i18n="footer_contact">Contact</a>
        </div>
      </div>
    </footer>

    <AIHelper />
  </body>
</html>
