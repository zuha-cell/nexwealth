---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Coming Soon">
  <section class="max-w-2xl mx-auto px-6 py-24 text-center">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Coming soon</p>
    <h1 class="font-display text-3xl text-indigo mb-4">This section is still being built.</h1>
    <p class="text-ink/65 mb-8">
      In the meantime, check out the Learning Centre and Calculators — those
      are live and ready to use.
    </p>
    <a href="/" class="inline-block bg-indigo text-paper px-6 py-3 rounded-full font-medium hover:bg-indigoLight transition-colors">
      Back to Home
    </a>
  </section>
</Layout>
