---
import Layout from "../../layouts/Layout.astro";

const articles = [
  {
    title: "Complete Mutual Fund Guide for Beginners",
    desc: "Every fund type explained — risk, ideal duration, and sample portfolio mixes.",
    href: "/learn/mutual-fund-guide",
  },
  {
    title: "Documents Needed to Start Trading & Investing",
    desc: "The exact checklist for opening a demat and trading account.",
    href: "/learn/open-account-guide",
  },
  {
    title: "NRI Account Opening Guide",
    desc: "Documents, PIS rules, and trading restrictions specific to NRI accounts.",
    href: "/learn/nri-account-guide",
  },
  {
    title: "Frequently Asked Questions",
    desc: "Can I start with ₹100? Is this legitimate? Answers to common questions.",
    href: "/learn/faq",
  },
];
---

<Layout title="Learning Centre" description="Plain-language guides to saving, investing, and mutual funds.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="font-display text-4xl text-indigo mb-3">Learning Centre</h1>
    <p class="text-ink/65 mb-10">Guides written to actually be read — no jargon left unexplained.</p>
    <div class="grid sm:grid-cols-2 gap-6">
      {articles.map((a) => (
        <a href={a.href} class="block border border-line rounded-2xl p-6 hover:border-indigo transition-colors">
          <h3 class="font-display text-lg text-indigo mb-2">{a.title}</h3>
          <p class="text-sm text-ink/65">{a.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
