---
import Layout from "../layouts/Layout.astro";

const nriDocs = [
  "PAN card copy",
  "Passport copy (photo page and address page — or just the photo page if it's a foreign passport)",
  "Indian address proof, if any (skip if your passport already shows an Indian address)",
  "Residency permit / Work permit / VISA / OCI card (if in India while opening, include the arrival stamp page from your passport)",
  "Overseas address proof — one of: recent utility bill (under 2 months old), valid driving license, National Population Register letter, residency card, banker's letter, self-attested overseas bank statement (under 2 months old), rent/lease agreement, or an employer's overseas assignment letter",
  "Tax Identification Number (TIN) document from your country of residence",
];

const foreignPassportOVD = [
  "Driving License",
  "Any address card issued by a government authority abroad",
  "Letter from the National Population Register showing foreign address",
];

const fnoIncomeProof = [
  "Latest 6 months' bank statement with a closing balance above ₹10,000",
  "Latest ITR copy",
  "Demat valuation statement showing holdings worth ₹10,000 or more",
];

const tradingRules = [
  "Don't transfer funds directly to your Sharekhan trading account for margin — for NRIs, all funds are held in your PIS bank account, which sets your trading limit.",
  "For F&O transactions specifically, funds are transferred directly to Sharekhan's trading ledger via NEFT/RTGS — ask your NRI relationship team for the exact beneficiary details.",
  "NRIs can only do delivery-based equity trades. Intraday trading, Buy Today Sell Tomorrow (BTST), and short selling are not permitted.",
  "NRE PIS permission can only be held with one bank at a time. NRO accounts can be opened with multiple banks.",
  "An NRO account still needs a separate NRO Investment/Special savings account for TDS deduction purposes, even though it doesn't require PIS permission.",
  "You can invest up to 5% of a company's paid-up capital, and some stocks are restricted for NRIs entirely — Sharekhan blocks these automatically, but you can check current limits on NSDL's and CDSL's foreign investment monitoring portals.",
  "100% funds are required upfront to buy, and 100% stock must be held to sell — no leverage or short selling.",
  "Payments are handled bill-to-bill — purchases and sales can't be adjusted against each other.",
  "IPOs are applied through your bank's ASBA internet banking, using your Sharekhan demat account number for allotment.",
  "Mutual funds are available through the NRO Non-PIS category, and via the NSE NMF platform for both NRE and NRO accounts.",
];
---

<Layout title="NRI Account Opening Guide" description="Documents and trading rules for NRIs opening a demat and trading account.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">For NRIs</p>
    <h1 class="font-display text-4xl text-indigo mb-6">NRI account opening guide</h1>
    <p class="text-ink/70 leading-relaxed mb-10">
      NRI accounts follow a few extra rules under FEMA and RBI regulations —
      here's what you'll need and what to expect once your account is open.
    </p>

    <h2 class="font-display text-2xl text-indigo mb-4">Documents checklist</h2>
    <div class="grid gap-3 mb-6">
      {nriDocs.map((doc, i) => (
        <div class="border border-line rounded-2xl p-4 flex gap-3">
          <span class="font-display text-lg text-gold shrink-0">{i + 1}</span>
          <p class="text-sm text-ink/70">{doc}</p>
        </div>
      ))}
    </div>

    <div class="border border-line rounded-2xl p-5 mb-6 bg-indigo/5">
      <h3 class="font-medium text-indigo mb-2 text-sm">If you hold a foreign passport (for OVD)</h3>
      <ul class="text-sm text-ink/70 space-y-1 list-disc list-inside">
        {foreignPassportOVD.map((d) => <li>{d}</li>)}
      </ul>
    </div>

    <div class="border border-line rounded-2xl p-5 mb-10 bg-indigo/5">
      <h3 class="font-medium text-indigo mb-2 text-sm">If you want to trade Futures &amp; Options — one of these income proofs</h3>
      <ul class="text-sm text-ink/70 space-y-1 list-disc list-inside">
        {fnoIncomeProof.map((d) => <li>{d}</li>)}
      </ul>
    </div>

    <p class="text-sm text-ink/60 border-l-2 border-gold pl-4 mb-12">
      <strong>Important:</strong> if you're opening the account while overseas,
      every document needs to be self-attested <em>and</em> attested by an
      overseas authority — Indian embassy, magistrate, court, an overseas
      notary, overseas banker, or Justice of the Peace confirming "documents
      verified with originals." If you're in India at the time, self-attestation
      alone is enough.
    </p>

    <h2 class="font-display text-2xl text-indigo mb-4">Trading rules for NRIs</h2>
    <ul class="space-y-3 mb-12">
      {tradingRules.map((rule) => (
        <li class="flex gap-3 text-sm text-ink/70">
          <span class="text-gain shrink-0">✓</span>
          <span>{rule}</span>
        </li>
      ))}
    </ul>

    <div class="border border-line rounded-2xl p-8 bg-indigo/5">
      <h2 class="font-display text-xl text-indigo mb-3">Ready to open your NRI account?</h2>
      <p class="text-sm text-ink/70 mb-5">
        I can walk you through the process directly — every NRI account has
        a few details specific to your country of residence and bank, so
        it's worth a quick conversation before you start.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact" class="bg-indigo text-paper px-5 py-2.5 rounded-full text-sm font-medium hover:bg-indigoLight transition-colors">
          Get in touch
        </a>
        <a href="mailto:md_zuhair.owner@bp.sharekhan.com" class="border border-line px-5 py-2.5 rounded-full text-sm font-medium hover:border-indigo transition-colors">
          Email directly
        </a>
      </div>
    </div>
  </section>
</Layout>
