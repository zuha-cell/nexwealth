---
import Layout from "../../layouts/Layout.astro";

const fundTypes = [
  ["Liquid", "Parks cash in very short-term debt", "Very Low", "Days–6 months", "Emergency fund"],
  ["Ultra Short Debt", "Short-term debt", "Low", "3–12 months", "Short-term goals"],
  ["Debt", "Government & corporate bonds", "Low", "1–3 years", "Conservative"],
  ["Hybrid", "Mix of equity & debt", "Medium", "3–5 years", "Balanced investors"],
  ["Balanced Advantage", "Dynamic equity/debt", "Medium", "3–5 years", "Lower volatility"],
  ["Multi Asset", "Equity + Debt + Gold", "Medium", "5+ years", "Diversification"],
  ["Large Cap", "Large companies", "Medium", "5+ years", "Core investing"],
  ["Flexi Cap", "Manager shifts across all caps", "Med–High", "5+ years", "One-fund solution"],
  ["Multi Cap", "Large/Mid/Small exposure", "Med–High", "5+ years", "Diversified equity"],
  ["Mid Cap", "Medium companies", "High", "7+ years", "Growth"],
  ["Small Cap", "Small companies", "Very High", "7–10+ years", "Aggressive growth"],
  ["Index", "Tracks Nifty/Sensex", "Medium", "5+ years", "Beginners"],
  ["ELSS", "Tax-saving equity", "Med–High", "3+ years", "Tax planning"],
  ["Gold", "Tracks gold", "Medium", "5+ years", "Inflation hedge"],
  ["International", "Invests abroad", "Med–High", "5+ years", "Global diversification"],
  ["Sector/Thematic", "Specific industries", "Very High", "7+ years", "Experienced investors"],
  ["Shariah / Ethical", "Screened for Shariah compliance or ESG criteria", "Med–High", "5+ years", "Values-based investors"],
  ["Retirement", "Built for long-horizon retirement corpus building", "Medium", "10+ years", "Retirement planning"],
  ["Children's Education", "Structured around a child's education timeline", "Medium", "10-18 years", "Education goal planning"],
];

const mixes = [
  { name: "Conservative", mix: "20% Liquid, 40% Debt, 20% Hybrid, 20% Index" },
  { name: "Balanced", mix: "20% Debt, 40% Index, 20% Flexi Cap, 10% Mid Cap, 10% Gold" },
  { name: "Growth", mix: "40% Index, 25% Flexi Cap, 20% Mid Cap, 10% Small Cap, 5% Gold" },
  { name: "Aggressive", mix: "35% Index, 25% Flexi Cap, 20% Mid Cap, 10% Small Cap, 10% International" },
  { name: "Global Diversified", mix: "50% India Equity, 20% US, 10% Global, 10% Gold, 10% Multi Asset" },
  { name: "Retirement", mix: "60% Equity, 30% Debt, 10% Gold — shift toward debt with age" },
];
---

<Layout title="Complete Mutual Fund Guide for Beginners" description="Every mutual fund type explained — risk, duration, and sample portfolio mixes.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Learning Centre</p>
    <h1 class="font-display text-4xl text-indigo mb-6">Complete Mutual Fund Guide for Beginners</h1>
    <p class="text-ink/70 leading-relaxed mb-10">
      Mutual funds aren't one thing — they're dozens of different tools built
      for different jobs. This guide walks through the main types, how risky
      each one is, how long you should plan to hold it, and a few ready-made
      portfolio mixes to start from.
    </p>

    <h2 class="font-display text-2xl text-indigo mb-4">Fund types at a glance</h2>
    <div class="border border-line rounded-2xl overflow-x-auto mb-12">
      <table class="w-full text-sm">
        <thead class="bg-indigo/5 text-left">
          <tr>
            <th class="px-4 py-3">Type</th>
            <th class="px-4 py-3">What it does</th>
            <th class="px-4 py-3">Risk</th>
            <th class="px-4 py-3">Ideal duration</th>
            <th class="px-4 py-3">Suited for</th>
          </tr>
        </thead>
        <tbody>
          {fundTypes.map((row) => (
            <tr class="border-t border-line">
              {row.map((cell, i) => (
                <td class={`px-4 py-2 ${i === 0 ? "font-medium text-indigo" : "text-ink/70"}`}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="font-display text-2xl text-indigo mb-4">Sample portfolio mixes</h2>
    <div class="grid sm:grid-cols-2 gap-4 mb-12">
      {mixes.map((m) => (
        <div class="border border-line rounded-2xl p-5">
          <h3 class="font-display text-base text-indigo mb-2">{m.name}</h3>
          <p class="text-sm text-ink/65">{m.mix}</p>
        </div>
      ))}
    </div>

    <h2 class="font-display text-2xl text-indigo mb-2">See the actual top funds, by category</h2>
    <p class="text-sm text-ink/60 mb-4">Pulled from this week's real data — pick a category, see the top 3 by trailing return, and jump straight into a side-by-side comparison.</p>
    <div id="top-fund-chips" class="flex flex-wrap gap-2 mb-4"></div>
    <div id="top-fund-results" class="border border-line rounded-2xl divide-y divide-line mb-12"></div>

    <h2 class="font-display text-2xl text-indigo mb-4">Rules of thumb</h2>
    <ul class="text-ink/70 space-y-2 mb-12 list-disc list-inside">
      <li>Keep 2–5 mutual funds only — more than that adds complexity without much extra diversification.</li>
      <li>SIP monthly and stay invested through the ups and downs.</li>
      <li>Increase your SIP amount by 10–15% every year as income grows.</li>
      <li>A common equity-allocation rule of thumb: <strong>100 (or 120) minus your age</strong>, depending on your risk tolerance.</li>
      <li>Review and rebalance your portfolio about once a year.</li>
      <li>Keep 3–6 months of expenses in a Liquid Fund or savings account before investing aggressively.</li>
    </ul>

    <div class="border border-line rounded-2xl p-8 bg-indigo/5">
      <h2 class="font-display text-xl text-indigo mb-3">See what this looks like with real numbers</h2>
      <p class="text-sm text-ink/70 mb-5">
        The Savings &amp; Investment Calculator applies these exact portfolio
        mixes to this week's real fund data — pick a mix and see the
        projected return.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/calculators/savings-investment" class="bg-indigo text-paper px-5 py-2.5 rounded-full text-sm font-medium hover:bg-indigoLight transition-colors">
          Try the calculator
        </a>
        <a href="/resources" class="border border-line px-5 py-2.5 rounded-full text-sm font-medium hover:border-indigo transition-colors">
          Ready to invest? Open an account
        </a>
      </div>
    </div>
  </section>

  <script>
    import { getFundsProgressive, getCategories, topFundsByReturn, fundReturn, type FundRecord } from "../../lib/fundData";

    let allFunds: FundRecord[] = [];

    const QUICK_CHIPS: { label: string; categories: string[]; shariahOnly?: boolean }[] = [
      { label: "Large Cap", categories: ["Large Cap"] },
      { label: "Flexi Cap", categories: ["Flexi Cap"] },
      { label: "Small Cap", categories: ["Small Cap"] },
      { label: "ELSS (Tax Saving)", categories: ["ELSS"] },
      { label: "Shariah / Ethical", categories: ["Equity - Index", "Sectoral & Thematic", "Large Cap", "Flexi Cap"], shariahOnly: true },
      { label: "Retirement", categories: ["Retirement Planning"] },
      { label: "Children's Education", categories: ["Childrens Fund"] },
      { label: "Liquid (Emergency Fund)", categories: ["Liquid Funds - Growth"] },
    ];

    function renderChips() {
      const wrap = document.getElementById("top-fund-chips")!;
      wrap.innerHTML = QUICK_CHIPS.map(
        (c, i) => `<button type="button" data-idx="${i}" class="chip-btn px-4 py-2 rounded-full text-sm font-medium border border-line hover:border-indigo transition-colors">${c.label}</button>`
      ).join("");
      wrap.querySelectorAll<HTMLButtonElement>(".chip-btn").forEach((btn) => {
        btn.addEventListener("click", () => showTopFunds(QUICK_CHIPS[Number(btn.dataset.idx)]));
      });
    }

    function showTopFunds(chip: { label: string; categories: string[]; shariahOnly?: boolean }) {
      const results = document.getElementById("top-fund-results")!;
      let funds = topFundsByReturn(allFunds, chip.categories, chip.shariahOnly ? 30 : 3);
      if (chip.shariahOnly) {
        funds = funds.filter((f) => /shariah|ethical|esg/i.test(f.schemeName ?? "")).slice(0, 3);
      }

      if (!funds.length) {
        results.innerHTML = `<div class="p-4 text-sm text-ink/40">No fund data uploaded yet, or none found for "${chip.label}" this week.</div>`;
        return;
      }

      results.innerHTML = funds
        .map((f) => {
          const ret = fundReturn(f);
          const params = new URLSearchParams({ cat: f.category, fund: f.isin ?? f.schemeName });
          return `
          <div class="p-4 flex items-center justify-between gap-4">
            <div>
              <p class="font-medium text-indigo text-sm">${f.schemeName}</p>
              <p class="text-xs text-ink/45">${f.category}${ret !== null ? ` · ${ret.toFixed(1)}% CAGR` : ""}</p>
            </div>
            <a href="/calculators/compare?${params.toString()}" class="text-xs font-medium text-indigo underline shrink-0">Compare this fund →</a>
          </div>`;
        })
        .join("");
    }

    async function init() {
      renderChips();
      getFundsProgressive(
        (firstBatch) => { allFunds = firstBatch; },
        (fullData) => { allFunds = fullData; }
      );
    }

    init();
  </script>
</Layout>
