---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Compare: Savings vs FD vs Mutual Funds" description="Compare savings, FD, and up to 3 mutual funds side by side — SIP or lumpsum, against inflation.">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Calculator</p>
    <h1 class="font-display text-4xl text-indigo mb-3">Compare everything, one screen</h1>
    <p class="text-ink/65 mb-4">
      Savings account, FD, and up to 3 real mutual funds — side by side, SIP
      or lumpsum, checked against inflation.
    </p>
    <p id="data-status" class="text-xs text-ink/45 mb-8">Loading fund data...</p>

    <!-- Controls -->
    <div class="border border-line rounded-2xl p-6 mb-8 grid sm:grid-cols-2 gap-6 items-end">
      <div class="flex gap-2">
        <button type="button" id="mode-sip" class="flex-1 px-4 py-2 rounded-full text-sm font-medium border border-line">SIP</button>
        <button type="button" id="mode-lumpsum" class="flex-1 px-4 py-2 rounded-full text-sm font-medium border border-line">Lumpsum</button>
      </div>

      <label class="grid gap-1">
        <span class="text-xs font-medium text-ink/60" id="amount-label">Monthly SIP (₹)</span>
        <input type="number" id="amount" value="5000" min="0" step="100"
          class="border border-line rounded-lg px-3 py-2 font-mono text-sm" />
      </label>
    </div>

    <div class="border border-line rounded-2xl p-6 mb-8">
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium">Projection period</span>
        <div class="flex items-center gap-1">
          <input type="number" id="years-input" min="6" max="20" step="1" value="6"
            class="border border-line rounded px-2 py-1 font-mono text-sm w-16 text-right" />
          <span class="text-xs text-ink/40">years</span>
        </div>
      </div>
      <input type="range" id="years-slider" min="6" max="20" step="1" value="6" class="w-full" />
      <p class="text-xs text-ink/40 mt-2">
        Fund returns use the actual 5Yr CAGR as the assumed constant rate,
        projected out to whichever period you pick — real data only goes
        out to 5 years, so anything beyond that is an extrapolation, not a
        historical figure.
      </p>
    </div>

    <!-- Comparison grid -->
    <div id="comparison-grid" class="grid gap-4 mb-8" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));"></div>

    <button id="add-fund-btn" class="text-sm font-medium text-indigo underline mb-12">+ Add another fund to compare (up to 3)</button>

    <!-- Growth chart -->
    <div class="border border-line rounded-2xl p-6 mb-12">
      <div class="flex justify-between items-center mb-4">
        <h2 class="font-display text-lg text-indigo">Growth over time</h2>
        <div id="chart-legend" class="flex flex-wrap gap-3 text-xs"></div>
      </div>
      <svg id="growth-chart" viewBox="0 0 700 300" class="w-full h-auto"></svg>
    </div>

    <p class="text-xs text-ink/45">
      Savings and FD rates are editable to match your actual bank. Mutual
      fund figures use this week's real fund data. Estimates assume the
      historical rate holds constant — not guaranteed. Inflation figure is
      admin-set from the latest MoSPI CPI release, not a personalized
      forecast.
    </p>
  </section>

  <script>
    import { getFundsProgressive, getCategories, fundsInCategory, fundReturnForPeriod, averageReturn, type FundRecord } from "../../lib/fundData";
    import { db } from "../../lib/firebase";
    import { doc, getDoc } from "firebase/firestore";

    let allFunds: FundRecord[] = [];
    let mode: "sip" | "lumpsum" = "sip";
    let years = 6; // projection length in years, 6-20 — the rate itself always comes from 5Yr CAGR
    let inflationRate = 5.5;

    interface FundSlot { category: string; fundId: string }
    let fundSlots: FundSlot[] = [{ category: "", fundId: "" }];

    let savingsRate = 3.5;
    let fdRate = 7;

    function fmtINR(n: number) {
      return "₹" + Math.round(n).toLocaleString("en-IN");
    }

    function futureValueLumpsum(amount: number, ratePct: number, yrs: number) {
      return amount * Math.pow(1 + ratePct / 100, yrs);
    }
    function futureValueSIP(monthly: number, ratePct: number, yrs: number) {
      const i = ratePct / 100 / 12;
      const n = yrs * 12;
      if (i === 0) return monthly * n;
      return monthly * ((Math.pow(1 + i, n) - 1) / i) * (1 + i);
    }
    function invested(amount: number, yrs: number) {
      return mode === "sip" ? amount * yrs * 12 : amount;
    }
    function futureValue(amount: number, ratePct: number, yrs: number) {
      return mode === "sip" ? futureValueSIP(amount, ratePct, yrs) : futureValueLumpsum(amount, ratePct, yrs);
    }

    function referralFor(kind: "savings" | "fd" | "fund") {
      if (kind === "savings") return { label: "Open Kotak811 account", href: "https://h1e.in/kkjhZD" };
      if (kind === "fd") return { label: "Explore Stable Money", href: "https://stablemoney.onelink.me/rkWL/z5jw05ze" };
      return {
        label: "Open Sharekhan account",
        href: "https://diy.sharekhan.com/app/Account/RegisterFOS?grpcd=13977&type=pb&grpid=14427&utm_empcode=PB13977USER&FormType=CDSL&CustomerType=FOS",
      };
    }

    function barHeight(value: number, maxValue: number) {
      return maxValue > 0 ? Math.max(6, (value / maxValue) * 100) : 6;
    }

    function renderCard(name: string, sub: string, ratePct: number | null, kind: "savings" | "fd" | "fund", maxValue: number) {
      if (ratePct === null) {
        return `<div class="border border-line rounded-2xl p-4 flex items-center justify-center text-xs text-ink/40 min-h-[280px]">Pick a fund</div>`;
      }
      const amount = Number((document.getElementById("amount") as HTMLInputElement).value) || 0;
      const total = futureValue(amount, ratePct, years);
      const investedAmt = invested(amount, years);
      const gain = total - investedAmt;
      const gainPct = investedAmt > 0 ? (gain / investedAmt) * 100 : 0;
      const beatsInflation = ratePct - inflationRate;
      const heightPct = barHeight(total, maxValue);
      const colorClass = beatsInflation > 1 ? "text-gain" : beatsInflation < -1 ? "text-loss" : "text-ink/60";
      const badgeClass = beatsInflation > 1 ? "bg-gain/10 text-gain" : beatsInflation < -1 ? "bg-loss/10 text-loss" : "bg-ink/5 text-ink/50";
      const referral = referralFor(kind);

      return `
        <div class="border border-line rounded-2xl p-4 flex flex-col">
          <p class="font-medium text-indigo text-sm mb-0.5">${name}</p>
          <p class="text-xs text-ink/45 mb-3">${sub}</p>

          <div class="flex items-end h-24 mb-3">
            <div class="w-full bg-gold/70 rounded-t" style="height: ${heightPct}%"></div>
          </div>

          <p class="font-mono text-lg text-indigo">${fmtINR(total)}</p>
          <p class="text-xs ${colorClass} font-medium mb-2">+${fmtINR(gain)} (${gainPct.toFixed(1)}%)</p>

          <span class="text-[10px] px-2 py-1 rounded-full self-start mb-3 ${badgeClass}">
            ${beatsInflation > 1 ? `Beats inflation by ${beatsInflation.toFixed(1)}%` : beatsInflation < -1 ? `Below inflation by ${Math.abs(beatsInflation).toFixed(1)}%` : "Roughly tracks inflation"}
          </span>

          <a href="${referral.href}" target="_blank" rel="noopener noreferrer sponsored"
            class="mt-auto text-xs font-medium text-indigo underline pt-2 border-t border-line"
          >
            ${referral.label} →
          </a>
        </div>`;
    }

    function renderFundPicker(slotIndex: number) {
      const slot = fundSlots[slotIndex - 2];
      const categories = getCategories(allFunds);
      const catOptions = categories.map((c) => `<option value="${c}" ${c === slot.category ? "selected" : ""}>${c}</option>`).join("");
      const funds = slot.category ? fundsInCategory(allFunds, slot.category) : [];
      const fundOptions = funds
        .map((f) => `<option value="${f.isin ?? f.schemeName}" ${(f.isin ?? f.schemeName) === slot.fundId ? "selected" : ""}>${f.schemeName}</option>`)
        .join("");

      return `
        <div class="border border-line rounded-2xl p-4 flex flex-col gap-2 min-h-[280px]">
          <p class="text-xs font-medium text-ink/60">Fund ${slotIndex - 1}</p>
          <select data-slot="${slotIndex}" class="category-select border border-line rounded px-2 py-1.5 text-xs bg-white">
            <option value="">Choose category...</option>
            ${catOptions}
          </select>
          <select data-slot="${slotIndex}" class="fund-select border border-line rounded px-2 py-1.5 text-xs bg-white" ${!slot.category ? "disabled" : ""}>
            <option value="">Choose fund...</option>
            ${fundOptions}
          </select>
          ${slotIndex > 2 ? `<button data-slot="${slotIndex}" class="remove-slot text-xs text-loss underline mt-auto self-start">Remove</button>` : ""}
        </div>`;
    }

    function renderAll() {
      const grid = document.getElementById("comparison-grid")!;
      const amount = Number((document.getElementById("amount") as HTMLInputElement).value) || 0;

      const values: number[] = [
        futureValue(amount, savingsRate, years),
        futureValue(amount, fdRate, years),
      ];
      fundSlots.forEach((slot) => {
        const fund = allFunds.find((f) => f.category === slot.category && (f.isin ?? f.schemeName) === slot.fundId);
        if (fund) {
          const rate = fundReturnForPeriod(fund, 5);
          if (rate !== null) values.push(futureValue(amount, rate, years));
        }
      });
      const maxValue = Math.max(...values, 1);

      let html = "";
      html += `
        <div class="border border-line rounded-2xl p-4 flex flex-col gap-2">
          <p class="text-xs font-medium text-ink/60">Savings Account rate</p>
          <div class="flex items-center gap-1">
            <input type="number" id="savings-rate" value="${savingsRate}" step="0.1" min="0" max="15" class="border border-line rounded px-2 py-1 font-mono text-xs w-16" />
            <span class="text-xs text-ink/40">%</span>
          </div>
        </div>`;
      html += renderCard("Savings Account", "Editable rate", savingsRate, "savings", maxValue);

      html += `
        <div class="border border-line rounded-2xl p-4 flex flex-col gap-2">
          <p class="text-xs font-medium text-ink/60">FD rate</p>
          <div class="flex items-center gap-1">
            <input type="number" id="fd-rate" value="${fdRate}" step="0.1" min="0" max="15" class="border border-line rounded px-2 py-1 font-mono text-xs w-16" />
            <span class="text-xs text-ink/40">%</span>
          </div>
        </div>`;
      html += renderCard("Fixed Deposit", "Editable rate", fdRate, "fd", maxValue);

      fundSlots.forEach((slot, i) => {
        const slotIndex = i + 2;
        html += renderFundPicker(slotIndex);
        const fund = allFunds.find((f) => f.category === slot.category && (f.isin ?? f.schemeName) === slot.fundId);
        const rate = fund ? fundReturnForPeriod(fund, 5) : null;
        html += renderCard(fund?.schemeName ?? "Select a fund", fund?.category ?? "", rate, "fund", maxValue);
      });

      grid.innerHTML = html;
      attachGridListeners();
    }

    function attachGridListeners() {
      document.getElementById("savings-rate")?.addEventListener("input", (e) => {
        savingsRate = Number((e.target as HTMLInputElement).value) || 0;
        renderAll();
        renderChart();
      });
      document.getElementById("fd-rate")?.addEventListener("input", (e) => {
        fdRate = Number((e.target as HTMLInputElement).value) || 0;
        renderAll();
        renderChart();
      });
      document.querySelectorAll<HTMLSelectElement>(".category-select").forEach((el) => {
        el.addEventListener("change", () => {
          const i = Number(el.dataset.slot) - 2;
          fundSlots[i].category = el.value;
          fundSlots[i].fundId = "";
          renderAll();
          renderChart();
        });
      });
      document.querySelectorAll<HTMLSelectElement>(".fund-select").forEach((el) => {
        el.addEventListener("change", () => {
          const i = Number(el.dataset.slot) - 2;
          fundSlots[i].fundId = el.value;
          renderAll();
          renderChart();
        });
      });
      document.querySelectorAll<HTMLButtonElement>(".remove-slot").forEach((el) => {
        el.addEventListener("click", () => {
          const i = Number(el.dataset.slot) - 2;
          fundSlots.splice(i, 1);
          renderAll();
          renderChart();
          updateAddButton();
        });
      });
    }

    function updateAddButton() {
      const btn = document.getElementById("add-fund-btn")!;
      btn.classList.toggle("hidden", fundSlots.length >= 3);
    }

    const CHART_COLORS = ["#C79A45", "#1F7A5C", "#7A3B8E", "#B23B3B", "#387ED1"];

    function renderChart() {
      const svg = document.getElementById("growth-chart")!;
      const legend = document.getElementById("chart-legend")!;
      const amount = Number((document.getElementById("amount") as HTMLInputElement).value) || 0;
      const W = 700, H = 300, PAD = 40;

      // One series per line: name, rate, color
      const series: { name: string; rate: number; color: string }[] = [
        { name: "Savings", rate: savingsRate, color: "#94a3b8" },
        { name: "FD", rate: fdRate, color: "#1B2A4A" },
      ];
      const niftyRate = averageReturnCache;
      if (niftyRate !== null) series.push({ name: "Nifty/Index (avg)", rate: niftyRate, color: "#C79A45" });
      fundSlots.forEach((slot, i) => {
        const fund = allFunds.find((f) => f.category === slot.category && (f.isin ?? f.schemeName) === slot.fundId);
        if (fund) {
          const rate = fundReturnForPeriod(fund, 5);
          if (rate !== null) series.push({ name: fund.schemeName.slice(0, 24), rate, color: CHART_COLORS[i % CHART_COLORS.length] });
        }
      });

      // Compute yearly values for each series, 0..years
      const allValues: number[] = [];
      const paths = series.map((s) => {
        const points: [number, number][] = [];
        for (let yr = 0; yr <= years; yr++) {
          const val = futureValue(amount, s.rate, yr);
          points.push([yr, val]);
          allValues.push(val);
        }
        return { ...s, points };
      });
      const maxVal = Math.max(...allValues, 1);

      const x = (yr: number) => PAD + (yr / years) * (W - 2 * PAD);
      const y = (val: number) => H - PAD - (val / maxVal) * (H - 2 * PAD);

      let svgContent = `<line x1="${PAD}" y1="${H - PAD}" x2="${W - PAD}" y2="${H - PAD}" stroke="#D8DCE3" />`;
      svgContent += `<line x1="${PAD}" y1="${PAD}" x2="${PAD}" y2="${H - PAD}" stroke="#D8DCE3" />`;

      for (const s of paths) {
        const d = s.points.map(([yr, val], i) => `${i === 0 ? "M" : "L"} ${x(yr).toFixed(1)} ${y(val).toFixed(1)}`).join(" ");
        svgContent += `<path d="${d}" fill="none" stroke="${s.color}" stroke-width="2.5" />`;
      }
      svg.innerHTML = svgContent;

      legend.innerHTML = series
        .map((s) => `<span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:${s.color}"></span>${s.name}</span>`)
        .join("");
    }

    let averageReturnCache: number | null = null;

    function setMode(newMode: "sip" | "lumpsum") {
      mode = newMode;
      document.getElementById("mode-sip")!.classList.toggle("bg-indigo", mode === "sip");
      document.getElementById("mode-sip")!.classList.toggle("text-paper", mode === "sip");
      document.getElementById("mode-lumpsum")!.classList.toggle("bg-indigo", mode === "lumpsum");
      document.getElementById("mode-lumpsum")!.classList.toggle("text-paper", mode === "lumpsum");
      document.getElementById("amount-label")!.textContent = mode === "sip" ? "Monthly SIP (₹)" : "Lumpsum amount (₹)";
      renderAll();
    }

    function setYears(y: number) {
      years = Math.max(6, Math.min(20, y));
      const slider = document.getElementById("years-slider") as HTMLInputElement;
      const input = document.getElementById("years-input") as HTMLInputElement;
      if (document.activeElement !== slider) slider.value = String(years);
      if (document.activeElement !== input) input.value = String(years);
      renderAll();
      renderChart();
    }

    async function init() {
      try {
        const snap = await getDoc(doc(db, "settings", "inflationRate"));
        if (snap.exists() && typeof snap.data().rate === "number") inflationRate = snap.data().rate;
      } catch {}

      const statusEl = document.getElementById("data-status")!;
      getFundsProgressive(
        (firstBatch) => {
          allFunds = firstBatch;
          averageReturnCache = averageReturn(allFunds, ["Equity - Index"]);
          statusEl.textContent = allFunds.length ? `${allFunds.length} funds so far — loading the rest...` : "No fund data uploaded yet.";
          renderAll();
          renderChart();
        },
        (fullData) => {
          allFunds = fullData;
          averageReturnCache = averageReturn(allFunds, ["Equity - Index"]);
          statusEl.textContent = allFunds.length ? `Comparing against inflation of ${inflationRate}% and ${allFunds.length} real funds.` : "No fund data uploaded yet.";
          renderAll();
          renderChart();
        }
      );

      document.getElementById("mode-sip")?.addEventListener("click", () => setMode("sip"));
      document.getElementById("mode-lumpsum")?.addEventListener("click", () => setMode("lumpsum"));
      document.getElementById("years-slider")?.addEventListener("input", (e) => setYears(Number((e.target as HTMLInputElement).value)));
      document.getElementById("years-input")?.addEventListener("input", (e) => setYears(Number((e.target as HTMLInputElement).value)));
      document.getElementById("amount")?.addEventListener("input", () => { renderAll(); renderChart(); });
      document.getElementById("add-fund-btn")?.addEventListener("click", () => {
        if (fundSlots.length < 3) {
          fundSlots.push({ category: "", fundId: "" });
          renderAll();
          renderChart();
          updateAddButton();
        }
      });

      setMode("sip");
      setYears(6);
      updateAddButton();
    }

    init();
  </script>
</Layout>
