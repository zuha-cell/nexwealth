---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Browse Mutual Funds" description="See the fund data currently loaded on the site, filterable by category.">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Data</p>
    <h1 class="font-display text-4xl text-indigo mb-3">Browse funds</h1>
    <p class="text-ink/65 mb-8" id="data-status">Loading...</p>

    <div class="flex flex-wrap gap-3 mb-6 items-center justify-between">
      <div class="flex flex-wrap gap-3">
        <input id="search-box" type="text" placeholder="Search fund name..."
          class="border border-line rounded-lg px-4 py-2 text-sm w-56" />
        <button id="shariah-filter" type="button"
          class="border border-line rounded-lg px-4 py-2 text-sm hover:border-indigo transition-colors">
          Shariah / Ethical only
        </button>
        <select id="category-filter" class="border border-line rounded-lg px-4 py-2 text-sm bg-white">
          <option value="">All categories</option>
        </select>
        <select id="sort-by" class="border border-line rounded-lg px-4 py-2 text-sm bg-white">
          <option value="CAGR:3 Yr">Sort by 3Yr CAGR</option>
          <option value="CAGR:5 Yr">Sort by 5Yr CAGR</option>
          <option value="SIP Returns:3 Yr">Sort by 3Yr SIP Returns</option>
          <option value="aumCr">Sort by AUM</option>
        </select>
      </div>
      <button id="download-report" class="text-sm bg-indigo text-paper px-4 py-2 rounded-full hover:bg-indigoLight transition-colors whitespace-nowrap">
        Download full report (CSV)
      </button>
    </div>

    <div class="border border-line rounded-2xl overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-indigo/5 text-left">
          <tr>
            <th class="px-4 py-3">Scheme</th>
            <th class="px-4 py-3">Category</th>
            <th class="px-4 py-3 text-right">NAV</th>
            <th class="px-4 py-3 text-right">Expense %</th>
            <th class="px-4 py-3 text-right">3Yr CAGR</th>
            <th class="px-4 py-3 text-right">5Yr CAGR</th>
            <th class="px-4 py-3 text-right">3Yr SIP Ret.</th>
          </tr>
        </thead>
        <tbody id="fund-rows"></tbody>
      </table>
    </div>
  </section>

  <script>
    import { getFundsProgressive, getCategories } from "../../lib/fundData";

    let allFunds: any[] = [];

    function fmt(n: any) {
      if (n === undefined || n === null || n === "") return "—";
      const num = Number(n);
      return isNaN(num) ? "—" : num.toFixed(2);
    }

    let shariahOnly = false;

    function render() {
      const category = (document.getElementById("category-filter") as HTMLSelectElement).value;
      const sortKey = (document.getElementById("sort-by") as HTMLSelectElement).value;
      const search = (document.getElementById("search-box") as HTMLInputElement).value.trim().toLowerCase();

      let rows = category ? allFunds.filter((f) => f.category === category) : [...allFunds];
      if (shariahOnly) {
        rows = rows.filter((f) => /shariah|ethical|esg/i.test(f.schemeName ?? ""));
      }
      if (search) {
        rows = rows.filter((f) => f.schemeName?.toLowerCase().includes(search));
      }
      rows.sort((a, b) => {
        const av = sortKey === "aumCr" ? Number(a.aumCr) : Number(a.metrics?.[sortKey]);
        const bv = sortKey === "aumCr" ? Number(b.aumCr) : Number(b.metrics?.[sortKey]);
        return (isNaN(bv) ? -Infinity : bv) - (isNaN(av) ? -Infinity : av);
      });
      rows = rows.slice(0, 100); // keep the table light

      document.getElementById("fund-rows")!.innerHTML = rows
        .map(
          (f) => `
        <tr class="border-t border-line">
          <td class="px-4 py-2">${f.schemeName ?? "—"}</td>
          <td class="px-4 py-2 text-ink/60">${f.category ?? "—"}</td>
          <td class="px-4 py-2 text-right font-mono">${fmt(f.nav)}</td>
          <td class="px-4 py-2 text-right font-mono">${fmt(f.expenseRatio)}</td>
          <td class="px-4 py-2 text-right font-mono">${fmt(f.metrics?.["CAGR:3 Yr"])}%</td>
          <td class="px-4 py-2 text-right font-mono">${fmt(f.metrics?.["CAGR:5 Yr"])}%</td>
          <td class="px-4 py-2 text-right font-mono">${fmt(f.metrics?.["SIP Returns:3 Yr"])}%</td>
        </tr>`
        )
        .join("");
    }

    function populateCategoryOptions() {
      const categories = getCategories(allFunds);
      const catSelect = document.getElementById("category-filter") as HTMLSelectElement;
      const current = catSelect.value;
      catSelect.innerHTML = '<option value="">All categories</option>';
      for (const cat of categories) {
        const opt = document.createElement("option");
        opt.value = cat;
        opt.textContent = cat;
        catSelect.appendChild(opt);
      }
      catSelect.value = current;
    }

    function load() {
      const statusEl = document.getElementById("data-status")!;

      getFundsProgressive(
        (firstBatch) => {
          allFunds = firstBatch;
          if (allFunds.length === 0) {
            statusEl.textContent = "No fund data uploaded yet — go to /admin/upload to add this week's data.";
            return;
          }
          statusEl.textContent = `Showing first ${allFunds.length} funds — loading the rest...`;
          populateCategoryOptions();
          render();
        },
        (fullData) => {
          allFunds = fullData;
          statusEl.textContent = allFunds.length
            ? `${allFunds.length} funds loaded. Showing top 100 by your selected sort.`
            : "No fund data uploaded yet — go to /admin/upload to add this week's data.";
          populateCategoryOptions();
          render();
        }
      );
    }

    function downloadFullReport() {
      if (!allFunds.length) return;
      const headers = ["schemeName", "category", "isin", "nav", "expenseRatio", "aumCr", "CAGR:3 Yr", "CAGR:5 Yr", "SIP Returns:3 Yr"];
      const escape = (v: any) => `"${String(v ?? "").replace(/"/g, '""')}"`;
      const lines = [headers.join(",")];
      for (const f of allFunds) {
        const row = [
          f.schemeName, f.category, f.isin, f.nav, f.expenseRatio, f.aumCr,
          f.metrics?.["CAGR:3 Yr"], f.metrics?.["CAGR:5 Yr"], f.metrics?.["SIP Returns:3 Yr"],
        ];
        lines.push(row.map(escape).join(","));
      }
      const blob = new Blob([lines.join("\n")], { type: "text/csv" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `nexwealth-fund-report-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    }

    document.getElementById("shariah-filter")?.addEventListener("click", () => {
      shariahOnly = !shariahOnly;
      const btn = document.getElementById("shariah-filter")!;
      btn.classList.toggle("bg-indigo", shariahOnly);
      btn.classList.toggle("text-paper", shariahOnly);
      render();
    });
    document.getElementById("category-filter")?.addEventListener("change", render);
    document.getElementById("sort-by")?.addEventListener("change", render);
    document.getElementById("search-box")?.addEventListener("input", render);
    document.getElementById("download-report")?.addEventListener("click", downloadFullReport);
    load();
  </script>
</Layout>
