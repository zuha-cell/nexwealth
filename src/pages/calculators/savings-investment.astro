---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Savings & Investment Calculator" description="Enter your salary, pick a budgeting rule, and see how much to invest — split across fund types if you like.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Calculator</p>
    <h1 class="font-display text-4xl text-indigo mb-3">Savings &amp; Investment Calculator</h1>
    <p class="text-ink/65 mb-4">
      Enter your monthly salary, pick a budgeting rule, then see how much to
      invest and what it could grow to — using this week's real fund data.
    </p>
    <p id="data-status" class="text-xs text-ink/45 mb-10">Loading fund data...</p>

    <div class="grid sm:grid-cols-2 gap-6 mb-10 items-start">
      <label class="grid gap-2">
        <span class="text-sm font-medium">Monthly take-home salary (₹)</span>
        <input id="salary" type="number" value="50000" min="0" step="500"
          class="border border-line rounded-lg px-4 py-3 text-lg font-mono focus:border-indigo outline-none" />
      </label>

      <!-- Small side calculator: equity allocation by age rule of thumb -->
      <div class="border border-line rounded-2xl p-5 bg-indigo/5">
        <p class="text-sm font-medium mb-2">Quick check: how much equity for your age?</p>
        <input id="age" type="number" min="18" max="80" step="1" placeholder="Enter your age"
          class="border border-line rounded-lg px-4 py-2 w-full font-mono focus:border-indigo outline-none mb-3" />
        <div id="age-rule-results" class="text-sm text-ink/60 hidden">
          <div class="flex justify-between py-1"><span>100 − age rule</span><span id="age-rule-100" class="font-mono text-indigo"></span></div>
          <div class="flex justify-between py-1"><span>120 − age rule</span><span id="age-rule-120" class="font-mono text-indigo"></span></div>
        </div>
        <p id="age-suggestion" class="text-xs text-ink/60 mt-2"></p>
      </div>
    </div>

    <!-- Rule cards -->
    <h2 class="font-display text-xl text-indigo mb-4">1. Choose a budgeting rule</h2>
    <div class="grid md:grid-cols-3 gap-6 mb-12">
      <div id="rule-502030" class="border border-line rounded-2xl p-6"></div>
      <div id="rule-701010" class="border border-line rounded-2xl p-6"></div>
      <div id="rule-702010" class="border border-line rounded-2xl p-6"></div>
    </div>

    <!-- Allocation -->
    <h2 class="font-display text-xl text-indigo mb-1">2. Where should the investable amount go?</h2>
    <p class="text-sm text-ink/55 mb-4">Using <strong id="active-rule-label">50/30/20</strong> — investable amount:
      <strong id="investable-amount" class="font-mono text-indigo"></strong> / month
    </p>

    <div class="flex gap-3 mb-6">
      <button id="mode-single" class="px-4 py-2 rounded-full text-sm font-medium border border-line">Single fund type</button>
      <button id="mode-diversify" class="px-4 py-2 rounded-full text-sm font-medium border border-line">Diversify</button>
    </div>

    <div id="single-panel" class="mb-8">
      <select id="single-category" class="border border-line rounded-lg px-4 py-2 text-sm bg-white mb-4"></select>
      <div id="single-top-funds" class="text-sm border border-line rounded-xl divide-y divide-line"></div>
    </div>

    <div id="diversify-panel-wrapper" class="hidden mb-8">
      <div class="flex flex-wrap gap-2 mb-5" id="preset-buttons"></div>
      <div id="diversify-panel" class="space-y-3"></div>
    </div>

    <!-- Period -->
    <h2 class="font-display text-xl text-indigo mb-4">3. Time period</h2>
    <label class="grid gap-2 mb-2 max-w-md">
      <span class="text-sm font-medium">Investing for <span id="months-label" class="font-mono text-indigo"></span></span>
      <input id="months" type="range" min="6" max="360" step="6" value="120" class="w-full" />
    </label>

    <!-- Results -->
    <div class="border border-line rounded-2xl p-8 my-10 grid sm:grid-cols-3 gap-4">
      <div>
        <p class="text-xs uppercase tracking-wide text-ink/50 mb-1">Invested</p>
        <p id="result-invested" class="font-mono text-xl text-indigo">₹0</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wide text-ink/50 mb-1">Est. returns</p>
        <p id="result-returns" class="font-mono text-xl text-gain">₹0</p>
      </div>
      <div class="bg-indigo rounded-xl p-4 -m-4">
        <p class="text-xs uppercase tracking-wide text-paper/60 mb-1">Est. total corpus</p>
        <p id="result-total" class="font-mono text-xl text-paper">₹0</p>
      </div>
    </div>

    <!-- Comparison -->
    <h2 class="font-display text-xl text-indigo mb-4">Side-by-side: which rule builds more?</h2>
    <div class="border border-line rounded-2xl overflow-hidden mb-6">
      <table class="w-full text-sm">
        <thead class="bg-indigo/5 text-left">
          <tr><th class="px-4 py-3">Rule</th><th class="px-4 py-3 text-right">Invests / month</th><th class="px-4 py-3 text-right">Projected corpus</th></tr>
        </thead>
        <tbody id="comparison-rows"></tbody>
      </table>
    </div>
    <p class="text-xs text-ink/45">
      Estimates use each fund category's actual trailing 3-year CAGR from this
      week's uploaded data, assumed constant going forward — real returns
      vary and are not guaranteed. This is educational, not personalized
      investment advice.
    </p>
  </section>

  <script>
    import { getFundsProgressive, averageReturn, topFundsByReturn, fundReturn, type FundRecord } from "../../lib/fundData";

    // ---------- Rule definitions ----------
    type Bucket = { key: string; label: string; percent: number; investable?: boolean };
    const rules: Record<string, { title: string; buckets: Bucket[] }> = {
      "502030": {
        title: "50/30/20 Rule",
        buckets: [
          { key: "needs", label: "Needs", percent: 50 },
          { key: "wants", label: "Wants", percent: 30 },
          { key: "savings", label: "Savings & Investments", percent: 20, investable: true },
        ],
      },
      "701010": {
        title: "70-10-10-10 Rule",
        buckets: [
          { key: "living", label: "Living Expenses", percent: 70 },
          { key: "longterm", label: "Long-term Investments", percent: 10, investable: true },
          { key: "shortterm", label: "Short-term Savings", percent: 10, investable: true },
          { key: "debt", label: "Debt / Personal Growth", percent: 10 },
        ],
      },
      "702010": {
        title: "70/20/10 Rule",
        buckets: [
          { key: "living", label: "Living Expenses", percent: 70 },
          { key: "savings", label: "Savings & Investments", percent: 20, investable: true },
          { key: "debtgiving", label: "Debt / Giving", percent: 10 },
        ],
      },
    };
    let activeRuleKey = "502030";

    // Proportionally redistributes the remaining percentage across the other
    // entries whenever one is changed, so the group always sums to 100 —
    // like a self-balancing pie, not independent sliders that can drift.
    function rebalance(entries: { key: string; percent: number }[], changedKey: string, newValue: number) {
      newValue = Math.max(0, Math.min(100, Math.round(newValue)));
      const changed = entries.find((e) => e.key === changedKey)!;
      changed.percent = newValue;

      const others = entries.filter((e) => e.key !== changedKey);
      const remaining = 100 - newValue;
      const othersSum = others.reduce((s, e) => s + e.percent, 0);

      if (others.length === 0) return;
      if (othersSum <= 0) {
        const share = remaining / others.length;
        others.forEach((e) => (e.percent = share));
      } else {
        others.forEach((e) => (e.percent = (e.percent / othersSum) * remaining));
      }

      others.forEach((e) => (e.percent = Math.round(e.percent)));
      const drift = 100 - entries.reduce((s, e) => s + e.percent, 0);
      if (drift !== 0 && others.length) {
        others[others.length - 1].percent += drift;
      }
    }

    function investablePercent(ruleKey: string) {
      return rules[ruleKey].buckets.filter((b) => b.investable).reduce((s, b) => s + b.percent, 0);
    }

    function renderRuleCard(ruleKey: string) {
      const rule = rules[ruleKey];
      const container = document.getElementById(`rule-${ruleKey}`)!;
      container.innerHTML = `
        <h3 class="font-display text-lg text-indigo mb-1">${rule.title}</h3>
        <p id="rule-total-${ruleKey}" class="text-xs mb-4 text-gain">Total: 100% — auto-balances</p>
        <div class="space-y-4">
          ${rule.buckets
            .map(
              (b, i) => `
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span>${b.label}${b.investable ? " <span class='text-gold'>(invested)</span>" : ""}</span>
                <span id="bucket-pct-${ruleKey}-${i}" class="font-mono">${b.percent}%</span>
              </div>
              <input type="range" min="0" max="100" value="${b.percent}"
                id="bucket-slider-${ruleKey}-${i}"
                data-rule="${ruleKey}" data-idx="${i}" class="bucket-slider w-full" />
            </div>`
            )
            .join("")}
        </div>
        <button class="use-rule-btn mt-5 text-sm font-medium text-indigo underline" data-rule="${ruleKey}">
          Use this rule for the calculator ↓
        </button>
      `;
    }

    // Updates slider positions and percent labels in place — no DOM rebuild,
    // so this is safe to call on every drag tick without breaking the drag.
    function updateRuleCardValues(ruleKey: string) {
      const rule = rules[ruleKey];
      rule.buckets.forEach((b, i) => {
        const slider = document.getElementById(`bucket-slider-${ruleKey}-${i}`) as HTMLInputElement | null;
        const label = document.getElementById(`bucket-pct-${ruleKey}-${i}`);
        if (slider && document.activeElement !== slider) slider.value = String(b.percent);
        if (label) label.textContent = `${b.percent}%`;
      });
    }

    function attachRuleListeners() {
      document.querySelectorAll<HTMLInputElement>(".bucket-slider").forEach((el) => {
        el.addEventListener("input", () => {
          const ruleKey = el.dataset.rule!;
          const idx = Number(el.dataset.idx);
          const bucket = rules[ruleKey].buckets[idx];
          rebalance(rules[ruleKey].buckets, bucket.key, Number(el.value));
          updateRuleCardValues(ruleKey);
          if (ruleKey === activeRuleKey) updateAll();
        });
      });
      document.querySelectorAll<HTMLButtonElement>(".use-rule-btn").forEach((el) => {
        el.addEventListener("click", () => {
          activeRuleKey = el.dataset.rule!;
          document.getElementById("active-rule-label")!.textContent = rules[activeRuleKey].title;
          updateAll();
        });
      });
    }

    // ---------- Fund data ----------
    let allFunds: FundRecord[] = [];
    const BROAD_MAP: Record<string, string[]> = {
      liquid: ["Liquid Funds - Growth"],
      debt: ["Ultra Short Duration", "Low Duration", "Short Duration", "Medium Duration", "Corporate Bond", "Banking & PSU", "Dynamic Bond"],
      hybrid: ["Aggressive Hybrid", "Balanced Hybrid", "Conservative Hybrid"],
      balancedAdvantage: ["Dynamic Asst Allocation&Bal Adv"],
      multiAsset: ["Multi Asset Alloaction"],
      index: ["Equity - Index"],
      largeCap: ["Large Cap"],
      flexiCap: ["Flexi Cap"],
      multiCap: ["Multi Cap"],
      midCap: ["Mid Cap"],
      smallCap: ["Small Cap"],
      elss: ["ELSS"],
      etf: ["ETF"],
      // No separate Gold/International/US category in the weekly data —
      // Fund of Funds is the closest available proxy (often includes
      // international/gold fund-of-funds). Flagged in the UI as approximate.
      goldIntl: ["Fund of Funds"],
    };

    const ASSET_LABELS: Record<string, string> = {
      liquid: "Liquid", debt: "Debt", hybrid: "Hybrid", balancedAdvantage: "Balanced Advantage",
      multiAsset: "Multi Asset", index: "Index", largeCap: "Large Cap", flexiCap: "Flexi Cap",
      multiCap: "Multi Cap", midCap: "Mid Cap", smallCap: "Small Cap", elss: "ELSS",
      etf: "ETF", goldIntl: "Gold / International (approx.)",
    };

    // Preset mixes from the Complete Mutual Fund Guide for Beginners.
    const PRESETS: Record<string, Record<string, number>> = {
      conservative: { liquid: 20, debt: 40, hybrid: 20, index: 20 },
      balanced: { debt: 20, index: 40, flexiCap: 20, midCap: 10, goldIntl: 10 },
      growth: { index: 40, flexiCap: 25, midCap: 20, smallCap: 10, goldIntl: 5 },
      aggressive: { index: 35, flexiCap: 25, midCap: 20, smallCap: 10, goldIntl: 10 },
      globalDiversified: { index: 50, goldIntl: 40, multiAsset: 10 },
      retirement: { index: 60, debt: 30, goldIntl: 10 },
      custom: { index: 40, hybrid: 20, etf: 20, liquid: 20 },
    };
    const PRESET_LABELS: Record<string, string> = {
      conservative: "Conservative", balanced: "Balanced", growth: "Growth",
      aggressive: "Aggressive", globalDiversified: "Global Diversified",
      retirement: "Retirement", custom: "Custom",
    };

    function categoryAvgReturn(cats: string[]): number {
      return averageReturn(allFunds, cats) ?? 8; // 8% fallback if no data uploaded yet
    }

    function topFunds(cats: string[], n = 5) {
      return topFundsByReturn(allFunds, cats, n);
    }

    // ---------- SIP future value ----------
    function sipFutureValue(monthly: number, annualRatePct: number, months: number) {
      const i = annualRatePct / 100 / 12;
      if (i === 0) return monthly * months;
      return monthly * ((Math.pow(1 + i, months) - 1) / i) * (1 + i);
    }

    // ---------- Allocation state ----------
    let mode: "single" | "diversify" = "single";
    let activePreset = "custom";
    let diversifyAlloc: Record<string, number> = { ...PRESETS.custom };

    function renderSingleTopFunds() {
      const key = (document.getElementById("single-category") as HTMLSelectElement).value;
      const funds = topFunds(BROAD_MAP[key]);
      document.getElementById("single-top-funds")!.innerHTML =
        funds
          .map(
            (f) => `<div class="px-4 py-2 flex justify-between">
          <span>${f.schemeName}</span>
          <span class="font-mono text-gain">${fundReturn(f)?.toFixed(2)}%</span>
        </div>`
          )
          .join("") || `<div class="px-4 py-3 text-ink/40">No fund data uploaded yet for this type.</div>`;
    }

    function renderPresetButtons() {
      const wrap = document.getElementById("preset-buttons")!;
      wrap.innerHTML = Object.keys(PRESETS)
        .map(
          (key) => `<button type="button" data-preset="${key}"
            class="preset-btn px-4 py-2 rounded-full text-sm font-medium border ${
              key === activePreset ? "bg-indigo text-paper border-indigo" : "border-line"
            }">${PRESET_LABELS[key]}</button>`
        )
        .join("");
      wrap.querySelectorAll<HTMLButtonElement>(".preset-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          activePreset = btn.dataset.preset!;
          diversifyAlloc = { ...PRESETS[activePreset] };
          renderPresetButtons();
          renderDiversifyPanel();
          updateAll();
        });
      });
    }

    function renderDiversifyPanel() {
      const panel = document.getElementById("diversify-panel")!;
      panel.innerHTML = `
        <p id="diversify-total" class="text-xs mb-2 text-gain">Total: 100% — auto-balances</p>
        ${Object.keys(diversifyAlloc)
          .map(
            (key) => `
          <div>
            <div class="flex justify-between text-sm mb-1">
              <span>${ASSET_LABELS[key]} <span class="text-ink/40">(avg ${categoryAvgReturn(BROAD_MAP[key]).toFixed(1)}% CAGR)</span></span>
              <span id="diversify-pct-${key}" class="font-mono">${diversifyAlloc[key]}%</span>
            </div>
            <input type="range" min="0" max="100" value="${diversifyAlloc[key]}"
              id="diversify-slider-${key}" data-key="${key}" class="diversify-slider w-full" />
          </div>`
          )
          .join("")}
      `;
      panel.querySelectorAll<HTMLInputElement>(".diversify-slider").forEach((el) => {
        el.addEventListener("input", () => {
          const entries = Object.entries(diversifyAlloc).map(([key, percent]) => ({ key, percent }));
          rebalance(entries, el.dataset.key!, Number(el.value));
          entries.forEach((e) => (diversifyAlloc[e.key] = e.percent));
          activePreset = "custom"; // manual tweak breaks from the named preset
          renderPresetButtons();
          updateDiversifyValues();
          updateAll();
        });
      });
    }

    // Lightweight — updates slider positions/labels without rebuilding the
    // DOM, so this is safe on every drag tick.
    function updateDiversifyValues() {
      Object.entries(diversifyAlloc).forEach(([key, percent]) => {
        const slider = document.getElementById(`diversify-slider-${key}`) as HTMLInputElement | null;
        const label = document.getElementById(`diversify-pct-${key}`);
        if (slider && document.activeElement !== slider) slider.value = String(percent);
        if (label) label.textContent = `${percent}%`;
      });
    }

    // ---------- Main compute ----------
    function computeCorpus(ruleKey: string, months: number): { invested: number; returns: number; total: number } {
      const salary = Number((document.getElementById("salary") as HTMLInputElement).value) || 0;
      const investable = salary * (investablePercent(ruleKey) / 100);

      let total = 0;
      if (mode === "single") {
        const key = (document.getElementById("single-category") as HTMLSelectElement).value;
        const rate = categoryAvgReturn(BROAD_MAP[key]);
        total = sipFutureValue(investable, rate, months);
      } else {
        const totalPct = Object.values(diversifyAlloc).reduce((a, b) => a + b, 0) || 1;
        for (const [key, pct] of Object.entries(diversifyAlloc)) {
          const portion = investable * (pct / totalPct);
          const rate = categoryAvgReturn(BROAD_MAP[key]);
          total += sipFutureValue(portion, rate, months);
        }
      }
      const invested = investable * months;
      return { invested, returns: total - invested, total };
    }

    function fmtINR(n: number) {
      return "₹" + Math.round(n).toLocaleString("en-IN");
    }

    function updateAll() {
      const salary = Number((document.getElementById("salary") as HTMLInputElement).value) || 0;
      const months = Number((document.getElementById("months") as HTMLInputElement).value);
      document.getElementById("months-label")!.textContent =
        months < 12 ? `${months} months` : `${(months / 12).toFixed(1)} years`;

      const investable = salary * (investablePercent(activeRuleKey) / 100);
      document.getElementById("investable-amount")!.textContent = fmtINR(investable);

      const result = computeCorpus(activeRuleKey, months);
      document.getElementById("result-invested")!.textContent = fmtINR(result.invested);
      document.getElementById("result-returns")!.textContent = fmtINR(result.returns);
      document.getElementById("result-total")!.textContent = fmtINR(result.total);

      // Comparison table — both rules, same allocation choice, same period
      const rows = Object.keys(rules)
        .map((rk) => {
          const inv = salary * (investablePercent(rk) / 100);
          const r = computeCorpus(rk, months);
          return `<tr class="border-t border-line ${rk === activeRuleKey ? "bg-gold/10" : ""}">
            <td class="px-4 py-2">${rules[rk].title}</td>
            <td class="px-4 py-2 text-right font-mono">${fmtINR(inv)}</td>
            <td class="px-4 py-2 text-right font-mono">${fmtINR(r.total)}</td>
          </tr>`;
        })
        .join("");
      document.getElementById("comparison-rows")!.innerHTML = rows;
    }

    function setMode(newMode: "single" | "diversify") {
      mode = newMode;
      document.getElementById("single-panel")!.classList.toggle("hidden", mode !== "single");
      document.getElementById("diversify-panel-wrapper")!.classList.toggle("hidden", mode !== "diversify");
      document.getElementById("mode-single")!.classList.toggle("bg-indigo", mode === "single");
      document.getElementById("mode-single")!.classList.toggle("text-paper", mode === "single");
      document.getElementById("mode-diversify")!.classList.toggle("bg-indigo", mode === "diversify");
      document.getElementById("mode-diversify")!.classList.toggle("text-paper", mode === "diversify");
      updateAll();
    }

    function ageToPreset(age: number): string {
      // Rough application of the "100/120 minus age" rule of thumb.
      if (age < 30) return "aggressive";
      if (age < 40) return "growth";
      if (age < 55) return "balanced";
      return "retirement";
    }

    function updateAgeSuggestion() {
      const ageInput = document.getElementById("age") as HTMLInputElement;
      const resultsBox = document.getElementById("age-rule-results")!;
      const el = document.getElementById("age-suggestion")!;
      const age = Number(ageInput.value);
      if (!age) {
        resultsBox.classList.add("hidden");
        el.textContent = "";
        return;
      }
      const rule100 = Math.max(0, Math.min(100, 100 - age));
      const rule120 = Math.max(0, Math.min(100, 120 - age));
      document.getElementById("age-rule-100")!.textContent = `${rule100}% equity`;
      document.getElementById("age-rule-120")!.textContent = `${rule120}% equity`;
      resultsBox.classList.remove("hidden");

      const suggested = ageToPreset(age);
      el.innerHTML = `The <strong>${PRESET_LABELS[suggested]}</strong> mix below roughly matches this — <button type="button" id="apply-age-preset" class="text-indigo underline">apply it</button>.`;
      document.getElementById("apply-age-preset")?.addEventListener("click", () => {
        activePreset = suggested;
        diversifyAlloc = { ...PRESETS[suggested] };
        setMode("diversify");
        renderPresetButtons();
        renderDiversifyPanel();
        updateAll();
      });
    }

    async function init() {
      renderRuleCard("502030");
      renderRuleCard("701010");
      renderRuleCard("702010");
      attachRuleListeners();

      const singleSelect = document.getElementById("single-category") as HTMLSelectElement;
      singleSelect.innerHTML = Object.entries(ASSET_LABELS)
        .map(([key, label]) => `<option value="${key}">${label}</option>`)
        .join("");

      const statusEl = document.getElementById("data-status")!;
      function refreshFundDependentUI(label: string) {
        statusEl.textContent = label;
        renderSingleTopFunds();
        renderPresetButtons();
        renderDiversifyPanel();
        updateAll();
      }

      getFundsProgressive(
        (firstBatch) => {
          allFunds = firstBatch;
          refreshFundDependentUI(
            allFunds.length
              ? `Using ${allFunds.length} funds so far — loading the rest in the background...`
              : "No fund data uploaded yet — estimates use an 8% fallback until you upload via /admin/upload."
          );
        },
        (fullData) => {
          allFunds = fullData;
          refreshFundDependentUI(
            allFunds.length
              ? `Using ${allFunds.length} funds from this week's uploaded data.`
              : "No fund data uploaded yet — estimates use an 8% fallback until you upload via /admin/upload."
          );
        }
      );

      setMode("single");

      document.getElementById("salary")?.addEventListener("input", updateAll);
      document.getElementById("age")?.addEventListener("input", updateAgeSuggestion);
      document.getElementById("months")?.addEventListener("input", updateAll);
      document.getElementById("single-category")?.addEventListener("change", () => {
        renderSingleTopFunds();
        updateAll();
      });
      document.getElementById("mode-single")?.addEventListener("click", () => setMode("single"));
      document.getElementById("mode-diversify")?.addEventListener("click", () => setMode("diversify"));

      updateAll();
    }

    init();
  </script>
</Layout>
