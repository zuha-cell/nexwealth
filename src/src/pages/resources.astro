---
import Layout from "../layouts/Layout.astro";

const resources = [
  {
    name: "Sharekhan Demat & Trading Account",
    desc: "Open a demat/trading account to invest in stocks, mutual funds, and ETFs.",
    href: "https://diy.sharekhan.com/app/Account/RegisterFOS?grpcd=13977&type=pb&grpid=14427&utm_empcode=PB13977USER&FormType=CDSL&CustomerType=FOS",
    cta: "Open account",
  },
  {
    name: "Turtlemint Insurance",
    desc: "Compare and buy life, health, and general insurance policies through my advisor profile.",
    href: "https://advisor.turtlemintinsurance.com/profile/MUH4331373/muhammed_zuhair_nalakath",
    cta: "View advisor profile",
  },
];

// Investment & banking partners — regulated financial products.
const partners = [
  {
    name: "Wint Wealth",
    initials: "WW",
    color: "#0F5E4C",
    category: "Bonds",
    desc: "9–12% fixed returns on curated bonds, 0 defaults to date. Backed by Zerodha, 3,00,000+ investors.",
    perk: "Extra 0.25% YTM (brokerage waiver) for the first 7 days after signup.",
    href: "https://www.wintwealth.com/bonds/referral/invite?referralCode=DDDCEF&utm_source=whatsapp&utm_medium=share_button&utm_platform=app",
    cta: "Explore Wint Wealth",
  },
  {
    name: "Zerodha Coin",
    initials: "ZC",
    color: "#387ED1",
    category: "Mutual Funds",
    desc: "Commission-free, direct mutual fund investing on Coin by Zerodha.",
    perk: null,
    href: "https://zerodha.com/open-account?c=HHV832",
    cta: "Open Zerodha account",
  },
  {
    name: "Stable Money",
    initials: "SM",
    color: "#1B2A4A",
    category: "Fixed Deposits",
    desc: "8.30% annual FD returns, up to ₹5L insured by RBI's DICGC.",
    perk: "₹200 reward on your first FD booking.",
    href: "https://stablemoney.onelink.me/rkWL/z5jw05ze",
    cta: "Explore Stable Money",
  },
  {
    name: "LenDenClub",
    initials: "LC",
    color: "#C79A45",
    category: "P2P Lending",
    desc: "RBI-regulated peer-to-peer lending — choose who to lend to, earn through repayments.",
    perk: "₹100 cashback on lending your first ₹1,000 (code: 8606624745).",
    href: "https://ldc.xyz/t/t3RVIvBh",
    cta: "Explore LenDenClub",
  },
  {
    name: "InCred Money",
    initials: "IM",
    color: "#7A3B8E",
    category: "Diversified Investments",
    desc: "Curated investment products to diversify your portfolio and target higher returns.",
    perk: null,
    href: "https://incredmoney.app.link/1PQ2fY5sh1b",
    cta: "Explore InCred Money",
  },
  {
    name: "Kotak811",
    initials: "K8",
    color: "#ED1C24",
    category: "Digital Banking",
    desc: "100% digital, zero-balance savings account, trusted by 2.5+ crore Indians. Metal debit card with lounge access.",
    perk: "₹50 instantly on account opening, up to ₹6,000 cashback with 811 Super.",
    href: "https://h1e.in/kkjhZD",
    cta: "Open Kotak811 account",
  },
  {
    name: "Slice",
    initials: "SL",
    color: "#EC4899",
    category: "Digital Banking",
    desc: "Zero-balance savings account with daily interest, roughly matching 100% of the RBI repo rate. Also offers a UPI credit card with up to 3% cashback.",
    perk: "₹500 on your first payment (code: MUHAM54154).",
    href: "https://slice.bank.in/t?c=ztOt0Fe&ic=MUHAM54154",
    cta: "Get Slice",
  },
];

// Crypto — different risk/regulatory category from the rest of this page, kept separate deliberately.
const cryptoPartners = [
  {
    name: "Binance",
    initials: "BN",
    color: "#F0B90B",
    category: "Crypto Exchange",
    desc: "Global crypto exchange. Referral campaign currently offers USDC rewards for completing signup tasks.",
    perk: null,
    href: "https://www.binance.com/referral/earn-together/refer2earn-usdc/claim?hl=en&ref=GRO_28502_PMNMX&utm_medium=app_share_link_whatsapp&utm_source=referral_entrance",
    cta: "Explore Binance",
  },
];

// App referral perks — not investment products, just useful everyday apps.
const appPerks = [
  {
    name: "super.money",
    image: "/supermoney-21.jpg",
    desc: "Smooth UPI payments app.",
    perk: "₹21 free cash on your first payment.",
    href: "https://link.super.money/ZsgcLKVBRZb",
  },
  {
    name: "super.money",
    image: "/supermoney-600.jpg",
    desc: "Complete more actions in the app to unlock bigger rewards.",
    perk: "Earn up to ₹600 in cashback.",
    href: "https://link.super.money/ZsgcLKVBRZb",
  },
  {
    name: "Paytm",
    image: "/paytm-100.jpg",
    desc: "UPI, recharge, and bill payments.",
    perk: "Up to ₹100 cashback + ₹50 recharge voucher on your first UPI payment of ₹10+.",
    href: "https://p.paytm.me/xCTH/kki0yily?utmt=080211",
  },
