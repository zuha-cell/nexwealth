---

<Layout title="Resources">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="font-display text-4xl text-indigo mb-3">Resources</h1>
    <p class="text-ink/65 mb-10">Vetted partners for opening accounts and buying financial products. Links are updated centrally — always current.</p>
    <div class="grid sm:grid-cols-2 gap-6 mb-12">
      {resources.map((r) => (
        <div class="border border-line rounded-2xl p-6 flex flex-col">
          <h3 class="font-display text-lg text-indigo mb-2">{r.name}</h3>
          <p class="text-sm text-ink/65 mb-5 flex-1">{r.desc}</p>
          <a href={r.href} target="_blank" rel="noopener noreferrer"
            class="self-start bg-indigo text-paper px-5 py-2 rounded-full text-sm font-medium hover:bg-indigoLight transition-colors"
          >
            {r.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="border border-line rounded-2xl p-8 flex flex-col sm:flex-row items-center gap-8 mb-16">
      <img src="/sharekhan-qr.jpg" alt="Scan to open a free Mirae Asset Sharekhan Demat account" class="w-48 h-auto rounded-lg border border-line" />
      <div>
        <h3 class="font-display text-lg text-indigo mb-2">Scan to get started</h3>
        <p class="text-sm text-ink/65 mb-4">
          Scan this QR code with your phone camera to open a free Mirae Asset
          Sharekhan Demat account — the fastest way to start your share
          market journey.
        </p>
        <a href="https://diy.sharekhan.com/app/Account/RegisterFOS?grpcd=13977&type=pb&grpid=14427&utm_empcode=PB13977USER&FormType=CDSL&CustomerType=FOS"
          target="_blank" rel="noopener noreferrer"
          class="text-sm font-medium text-indigo underline"
        >
          Or click here instead of scanning
        </a>
      </div>
    </div>

    <!-- Partner offers -->
    <h2 class="font-display text-2xl text-indigo mb-2">Partner offers</h2>
    <p class="text-xs text-ink/45 mb-8">
      Disclosure: some links below are referral links — signing up through
      them may earn a small commission or reward for both of us, at no extra
      cost to you.
    </p>

    <h3 class="font-display text-lg text-indigo mb-4">Investment &amp; banking</h3>
    <div class="grid sm:grid-cols-2 gap-5 mb-12">
      {partners.map((p) => (
        <div class="border border-line rounded-2xl p-5 flex flex-col">
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg flex items-center justify-center text-white text-xs font-bold shrink-0"
              style={`background-color: ${p.color}`}
            >
              {p.initials}
            </div>
            <div>
              <h4 class="font-medium text-indigo text-sm">{p.name}</h4>
              <p class="text-xs text-ink/40">{p.category}</p>
            </div>
          </div>
          <p class="text-sm text-ink/65 mb-2 flex-1">{p.desc}</p>
          {p.perk && <p class="text-xs text-gain mb-4">🎁 {p.perk}</p>}
          <a href={p.href} target="_blank" rel="noopener noreferrer sponsored"
            class="self-start text-sm font-medium text-indigo underline"
          >
            {p.cta}
          </a>
        </div>
      ))}
    </div>

    <h3 class="font-display text-lg text-indigo mb-2">Crypto</h3>
    <p class="text-xs text-ink/45 mb-4">
      Crypto carries different risk and regulatory treatment than the
      SEBI/IRDAI-regulated products above — worth understanding before you
      invest.
    </p>
    <div class="grid sm:grid-cols-2 gap-5 mb-12">
      {cryptoPartners.map((p) => (
        <div class="border border-line rounded-2xl p-5 flex flex-col">
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg flex items-center justify-center text-white text-xs font-bold shrink-0"
              style={`background-color: ${p.color}`}
            >
              {p.initials}
            </div>
            <div>
              <h4 class="font-medium text-indigo text-sm">{p.name}</h4>
              <p class="text-xs text-ink/40">{p.category}</p>
            </div>
          </div>
          <p class="text-sm text-ink/65 mb-4 flex-1">{p.desc}</p>
          <a href={p.href} target="_blank" rel="noopener noreferrer sponsored"
            class="self-start text-sm font-medium text-indigo underline"
          >
            {p.cta}
          </a>
        </div>
      ))}
    </div>

    <h3 class="font-display text-lg text-indigo mb-4">Everyday app perks</h3>
    <div class="grid sm:grid-cols-3 gap-4">
      {appPerks.map((p) => (
        <a href={p.href} target="_blank" rel="noopener noreferrer sponsored"
          class="border border-line rounded-2xl overflow-hidden flex flex-col hover:border-indigo transition-colors"
        >
          <img src={p.image} alt={`${p.name} — ${p.perk}`} class="w-full h-40 object-cover" />
          <div class="p-4">
            <p class="text-sm font-medium text-indigo">{p.name}</p>
            <p class="text-xs text-ink/55 mt-1">{p.perk}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
