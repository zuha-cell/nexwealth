---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Lump Sum Calculator" description="See what a one-time investment could grow to, using a real fund's return or your own assumption.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-gold mb-3">Calculator</p>
    <h1 class="font-display text-4xl text-indigo mb-3">Lump Sum Calculator</h1>
    <p class="text-ink/65 mb-4">See what a one-time investment could grow to over time.</p>
    <p id="data-status" class="text-xs text-ink/45 mb-8">Loading fund data...</p>

    <div class="border border-line rounded-2xl p-6 mb-6">
      <p class="text-sm font-medium mb-3">Base the return rate on:</p>
      <div class="flex gap-3 mb-4">
        <button type="button" id="mode-custom" class="px-4 py-2 rounded-full text-sm font-medium border border-line">Custom rate</button>
        <button type="button" id="mode-fund" class="px-4 py-2 rounded-full text-sm font-medium border border-line">A real fund / ETF</button>
      </div>
      <div id="fund-picker" class="hidden grid gap-3 sm:grid-cols-2">
        <select id="category-select" class="border border-line rounded-lg px-4 py-2 text-sm bg-white"></select>
        <select id="fund-select" class="border border-line rounded-lg px-4 py-2 text-sm bg-white"></select>
      </div>
    </div>

    <div class="grid gap-6 bg-white/60 border border-line rounded-2xl p-8">
      <label class="grid gap-2">
        <span class="text-sm font-medium">Lump sum amount (₹)</span>
        <input type="number" id="amount" value="100000" min="0" step="1000"
          class="border border-line rounded-lg px-4 py-2 font-mono focus:border-indigo outline-none" />
      </label>

      <div>
        <div class="flex justify-between items-center mb-1">
          <span class="text-sm font-medium">Expected annual return <span id="rate-source" class="text-xs text-ink/40 font-normal"></span></span>
          <div class="flex items-center gap-1">
            <input type="number" id="rate-input" value="12" min="-30" max="60" step="0.1"
              class="border border-line rounded px-2 py-1 font-mono text-sm w-20 text-right" />
            <span class="text-xs text-ink/40">%</span>
          </div>
        </div>
        <input type="range" id="rate-slider" min="-10" max="30" step="0.1" value="12" class="w-full" />
      </div>

      <div>
        <div class="flex justify-between items-center mb-1">
          <span class="text-sm font-medium">Investment period</span>
          <span id="years-label" class="font-mono text-sm text-indigo"></span>
        </div>
        <input type="range" id="years" min="1" max="40" step="1" value="10" class="w-full" />
      </div>
    </div>

    <div class="mt-8 grid sm:grid-cols-3 gap-4">
      <div class="border border-line rounded-2xl p-6">
        <p class="text-xs uppercase tracking-wide text-ink/50 mb-1">Invested</p>
        <p id="invested" class="font-mono text-xl text-indigo">₹0</p>
      </div>
      <div class="border border-line rounded-2xl p-6">
        <p class="text-xs uppercase tracking-wide text-ink/50 mb-1">Est. returns</p>
        <p id="returns" class="font-mono text-xl text-gain">₹0</p>
      </div>
      <div class="border border-line rounded-2xl p-6 bg-indigo">
        <p class="text-xs uppercase tracking-wide text-paper/60 mb-1">Total value</p>
        <p id="total" class="font-mono text-xl text-paper">₹0</p>
      </div>
    </div>

    <p class="mt-8 text-xs text-ink/45">
      Educational estimate only, assumes a constant annual return compounded
      yearly. Past returns don't guarantee future performance.
    </p>
  </section>

  <script>
    import { getFundsProgressive, getCategories, fundsInCategory, fundReturn, type FundRecord } from "../../lib/fundData";

    let allFunds: FundRecord[] = [];
    let mode: "custom" | "fund" = "custom";

    function formatINR(n: number) {
      return "₹" + Math.round(n).toLocaleString("en-IN");
    }

    function calculate() {
      const amount = parseFloat((document.getElementById("amount") as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById("rate-input") as HTMLInputElement).value) || 0;
      const years = parseFloat((document.getElementById("years") as HTMLInputElement).value) || 0;

      document.getElementById("years-label")!.textContent =
        years === 1 ? "1 year" : `${years} years`;

      const futureValue = amount * Math.pow(1 + rate / 100, years);
      document.getElementById("invested")!.textContent = formatINR(amount);
      document.getElementById("returns")!.textContent = formatINR(futureValue - amount);
      document.getElementById("total")!.textContent = formatINR(futureValue);
    }

    function syncRate(value: number) {
      (document.getElementById("rate-input") as HTMLInputElement).value = String(value);
      (document.getElementById("rate-slider") as HTMLInputElement).value = String(value);
      calculate();
    }

    function populateCategorySelect() {
      const catSelect = document.getElementById("category-select") as HTMLSelectElement;
      catSelect.innerHTML = "";
      for (const cat of getCategories(allFunds)) {
        const opt = document.createElement("option");
        opt.value = cat;
        opt.textContent = cat;
        catSelect.appendChild(opt);
      }
    }

    function populateFundSelect() {
      const catSelect = document.getElementById("category-select") as HTMLSelectElement;
      const fundSelect = document.getElementById("fund-select") as HTMLSelectElement;
      const funds = fundsInCategory(allFunds, catSelect.value)
        .filter((f) => fundReturn(f) !== null)
        .sort((a, b) => (fundReturn(b) ?? 0) - (fundReturn(a) ?? 0));

      fundSelect.innerHTML = "";
      for (const f of funds) {
        const opt = document.createElement("option");
        opt.value = f.isin ?? f.schemeName;
        opt.textContent = `${f.schemeName} (${fundReturn(f)?.toFixed(1)}%)`;
        fundSelect.appendChild(opt);
      }
      applySelectedFund();
    }

    function applySelectedFund() {
      const catSelect = document.getElementById("category-select") as HTMLSelectElement;
      const fundSelect = document.getElementById("fund-select") as HTMLSelectElement;
      const funds = fundsInCategory(allFunds, catSelect.value);
      const fund = funds.find((f) => (f.isin ?? f.schemeName) === fundSelect.value);
      const rate = fund ? fundReturn(fund) : null;
      const rateSource = document.getElementById("rate-source")!;

      if (mode === "fund" && rate !== null) {
        syncRate(Number(rate.toFixed(2)));
        rateSource.textContent = `— actual 3Yr CAGR from ${fund!.schemeName}`;
      } else {
        rateSource.textContent = "";
      }
    }

    function setMode(newMode: "custom" | "fund") {
      mode = newMode;
      document.getElementById("fund-picker")!.classList.toggle("hidden", mode !== "fund");
      document.getElementById("mode-custom")!.classList.toggle("bg-indigo", mode === "custom");
      document.getElementById("mode-custom")!.classList.toggle("text-paper", mode === "custom");
      document.getElementById("mode-fund")!.classList.toggle("bg-indigo", mode === "fund");
      document.getElementById("mode-fund")!.classList.toggle("text-paper", mode === "fund");
      if (mode === "custom") {
        document.getElementById("rate-source")!.textContent = "";
      } else {
        applySelectedFund();
      }
    }

    async function init() {
      const statusEl = document.getElementById("data-status")!;
      getFundsProgressive(
        (firstBatch) => {
          allFunds = firstBatch;
          statusEl.textContent = allFunds.length ? `${allFunds.length} funds available so far — loading the rest...` : "No fund data uploaded yet — custom rate still works fine.";
          populateCategorySelect();
          populateFundSelect();
        },
        (fullData) => {
          allFunds = fullData;
          statusEl.textContent = allFunds.length ? `${allFunds.length} funds available to pick from.` : "No fund data uploaded yet — custom rate still works fine.";
          populateCategorySelect();
          populateFundSelect();
        }
      );

      document.getElementById("category-select")?.addEventListener("change", populateFundSelect);
      document.getElementById("fund-select")?.addEventListener("change", applySelectedFund);
      document.getElementById("mode-custom")?.addEventListener("click", () => setMode("custom"));
      document.getElementById("mode-fund")?.addEventListener("click", () => setMode("fund"));

      document.getElementById("rate-input")?.addEventListener("input", (e) => {
        syncRate(Number((e.target as HTMLInputElement).value));
      });
      document.getElementById("rate-slider")?.addEventListener("input", (e) => {
        syncRate(Number((e.target as HTMLInputElement).value));
      });
      document.getElementById("amount")?.addEventListener("input", calculate);
      document.getElementById("years")?.addEventListener("input", calculate);

      setMode("custom");
      calculate();
    }

    init();
  </script>
</Layout>
