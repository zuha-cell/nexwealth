---
import { LANGUAGES } from "../i18n/translations";
---

<select id="lang-toggle" class="text-xs border border-line rounded px-2 py-1 bg-white cursor-pointer" aria-label="Choose language">
  {LANGUAGES.map((l) => (
    <option value={l.code}>{l.label}</option>
  ))}
</select>

<script>
  import { translations, type Lang } from "../i18n/translations";

  const STORAGE_KEY = "nw_lang";

  function applyLang(lang: Lang) {
    const dict = translations[lang] ?? translations.en;
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
      const key = el.dataset.i18n!;
      if (dict[key]) el.textContent = dict[key];
    });
    document.documentElement.lang = lang;
  }

  function getSavedLang(): Lang {
    try {
      const saved = localStorage.getItem(STORAGE_KEY) as Lang | null;
      if (saved && translations[saved]) return saved;
    } catch {}
    return "en";
  }

  const select = document.getElementById("lang-toggle") as HTMLSelectElement;
  const current = getSavedLang();
  select.value = current;
  applyLang(current);

  select.addEventListener("change", () => {
    const lang = select.value as Lang;
    try {
      localStorage.setItem(STORAGE_KEY, lang);
    } catch {}
    applyLang(lang);
  });
</script>
